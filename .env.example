# Backend only. The same value may be used twice only if that 2GIS key has both products enabled.
DGIS_PLACES_API_KEY=
DGIS_ROUTING_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional backend safeguards. Defaults shown below.
DGIS_MAX_RETRIES=1
DGIS_MIN_REQUEST_INTERVAL_SECONDS=0.75
DGIS_PLACES_CACHE_SECONDS=900
DGIS_ROUTING_CACHE_SECONDS=1800
ROUTE_RESULT_CACHE_SECONDS=600
ROUTE_GOOD_DURATION_UTILIZATION=0.85
ROUTE_GOOD_QUALITY_SCORE=70
ROUTE_MAX_ROUTING_CHECKS=8
# Optional. By default routes persist in backend/data/gulyay.sqlite3.
GULYAY_DB_PATH=
GULYAY_ROUTE_RETENTION_HOURS=24
# For a downloaded debug APK on Android Emulator, set the GitHub Actions variable
# DEBUG_BACKEND_BASE_URL=http://10.0.2.2:8000 and run backend locally on port 8000.
# Android: CI secret DGIS_SDK_KEY_BASE64 contains the base64 of the entire dgissdk.key file.
# Android: CI variable BACKEND_BASE_URL is the HTTPS origin of the deployed backend.
# Android: CI variable DGIS_SDK_VERSION pins a tested 2GIS SDK release.
# These are configuration names, not credentials. Never commit real values.
